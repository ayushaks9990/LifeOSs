ENVIRONMENT=development
DATABASE_URL=sqlite:///./lifeos.db
SECRET_KEY=change-this-to-a-long-random-value
APP_ENCRYPTION_KEY=change-this-too
ACCESS_TOKEN_MINUTES=10080
ALLOWED_ORIGINS=http://localhost:5173

# Any OpenAI-compatible provider. Groq is the default.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Official YouTube Data API v3 key (yt-dlp is not used).
YOUTUBE_API_KEY=
YOUTUBE_REGION=IN

# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Leave blank to derive it from the public request URL.
GOOGLE_REDIRECT_URI=

# WhatsApp Business Cloud API webhook configuration.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

